+
+        verbose = progress.CollectingReporter(verbose=True)
+        Cluster(self.client, 'banana', 'testns',
+                reporter=verbose).delete(update_kubeconfig=True)
+
+        self.assertIn('Property "users.banana.testns" unset.',
