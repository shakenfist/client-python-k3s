+        self.assertEqual(
+            "A local kubectl binary is required to merge the new cluster into\n"
+            "/home/u/.kube/config, but none was found. The new cluster credentials are\n"
+            "available from 'sf-client k3s getconfig banana'.",
+            str(e))
