# Pyre type checker
.pyre/

# setuptools_scm's write_to used to generate this, and no longer does.
# The entry stays because checkouts which were built before that change
# still have the file sitting there untracked, where a git add -A would
# commit it -- and a generated file is exactly what this list is for,
# whether or not this project is still the thing generating it.
shakenfist_client_k3s/_version.py

# ansible-lint's working tree. ansible-compat installs the collection into
# collection/.ansible/ so that the module resolves by its fully qualified
# name, which means every pre-commit run leaves one behind. galaxy.yml's
# build_ignore keeps it out of the built collection as well.
collection/.ansible/

# tools/build-collection.py's output, built by the build-collection job in
# release.yml and by a local run of the script.
dist-collection/
